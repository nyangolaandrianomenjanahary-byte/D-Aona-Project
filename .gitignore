# Sauvegardes locales de la base (créées par `node backup_db.js`) — jamais versionnées :
# elles contiennent des données clients (comptes, transactions, chat).
d-aona-server/backups/

# Fichiers téléversés par les joueurs (photos de profil) = données personnelles.
# Ne doivent jamais entrer dans l'historique Git.
d-aona-server/uploads/
# ===== D-aôna — .gitignore =====

# Dépendances
node_modules/

# Bases de données (contenu clients → jamais sur GitHub)
*.db
*.sqlite

# Journaux / logs d'exécution
*.log

# Binaires
*.exe

# État généré (journal projet)
maj_state.json

# Copie locale d'outils / agents (skills) — pas du code de l'app
.agents/
.claude/
agent/
skills-lock.json

# Fichier placeholder
File path here

# Sorties de tests / debug générées (txt)
**/*_result.txt
**/*_res.txt
test-tools/*.txt
d-aona-server/*.txt
debug_outputs/*.txt

# Captures de test
d-aona-server/shots/

# Graphe de connaissances généré par graphify (régénérable via `py -m graphify update .`)
graphify-out/

# Secrets locaux (clé de session, mots de passe) — jamais versionnés.
# Le modèle à copier est fourni dans d-aona-server/.env.example
.env
.env.*
!.env.example

# Scripts jetables de session (sondes, découpages, mesures ponctuelles).
# Le harnais livré reste test_ui_scenarios.js, régénérable par `node _build.js`
# à partir des morceaux _p1.js ... _p12.js (ces deux-là sont versionnés).
d-aona-server/_*.js
!d-aona-server/_build.js
!d-aona-server/_p[0-9]*.js
d-aona-server/_*.err
d-aona-server/test_ui_scenarios.fixed.js

# Brouillons racine et artefacts d'outillage local (jamais du code de l'app)
tasks/
_graphify_ver.txt
_tmp_listen.txt
