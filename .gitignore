# ===== D-aôna — .gitignore =====
# Arborescence : apps/web (frontend), apps/api (backend), packages/, supabase/,
# scripts/, docs/. Les règles ci-dessous suivent ce découpage.

# ---------- Dépendances ----------
node_modules/

# ---------- Données clients : JAMAIS sur GitHub ----------
# Sauvegardes locales de la base (créées par `node apps/api/backup_db.js`).
apps/api/backups/

# Fichiers téléversés par les joueurs (photos de profil) = données personnelles.
apps/api/uploads/

# Pièces d'identité (KYC, recto + verso + selfie) : données personnelles
# sensibles. Servies uniquement par la route d'administration authentifiée et
# auditée — jamais par le serveur statique, jamais versionnées.
apps/api/private/


# Build statique Vercel (généré par `npm run vercel-build`)
public/
.vercel/

# Bases de données (contenu clients → jamais sur GitHub)
*.db
*.sqlite
*.sqlite3
apps/api/_oracle.db

# ---------- Secrets ----------
.env
.env.*
!.env.example
!.env.*.example
.vercel/

# ---------- Journaux / bruits d'exécution ----------
*.log
*.err
*.out
debug.log
apps/api/*.txt
**/*_result.txt
**/*_res.txt
test-tools/*.txt
debug_outputs/*.txt

# ---------- Binaires ----------
*.exe

# ---------- État généré ----------
maj_state.json
_graphify_ver.txt
_tmp_listen.txt

# ---------- Graphe de connaissances (régénérable) ----------
graphify-out/

# ---------- Copies locales d'outils / agents (pas du code de l'app) ----------
.agents/
.claude/
agent/
skills-lock.json

# ---------- Scripts jetables et sondes ----------
# Le harnais livré reste test_ui_scenarios.js, régénérable depuis test/ui/parts.
apps/api/_*.js
apps/api/_*.err
apps/api/_*.py
apps/api/_*.out
apps/api/_*.cmd
apps/api/tools/
apps/api/__pycache__/
apps/api/_shots/
apps/api/shots/
apps/api/test_ui_scenarios.fixed.js
apps/api/_plateau_source.png

# Captures des audits locales : images de contrôle, jamais du code.
audit-*/shots/

# ---------- Brouillons racine ----------
tasks/

# ---------- Supabase local ----------
supabase/.branches/
supabase/.temp/
supabase/.env
