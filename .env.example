# =========================================================
# D-aôna (Vercel + Supabase) — Variables d'environnement
# =========================================================
# Copier dans `.env.local` pour les tests locaux ou configurer dans
# Vercel -> Project Settings -> Environment Variables.

# ---- Supabase Postgres (OBLIGATOIRE en production Vercel) ----
# Chaîne de connexion PostgreSQL (Transaction Pooler port 6543 recommandé sur Vercel,
# ou connexion directe port 5432).
# Exemple : postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-eu-west-3.pooler.supabase.com:6543/postgres
DATABASE_URL=

# ---- Supabase Realtime Broadcast (RECOMMANDÉ pour le multijoueur instantané) ----
# Sans ces deux variables, l'application bascule automatiquement sur le polling HTTP (/api/rt/poll).
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Optionnel côté serveur (fallback sur SUPABASE_ANON_KEY si absent)
SUPABASE_SERVICE_ROLE_KEY=

# ---- Authentification (optionnel) ----
# D_AONA_AUTH_RATE_MAX=12
# D_AONA_AUTH_RATE_WINDOW_S=300
