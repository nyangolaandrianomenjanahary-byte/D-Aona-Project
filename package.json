{
  "name": "d-aona-root",
  "private": true,
  "version": "1.0.0",
  "description": "D-aôna — monorepo : frontend (apps/web), backend (apps/api), base Supabase, scripts de vérification et d'outillage",
  "main": "api/index.js",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "build": "node scripts/build-vercel.js",
    "vercel-build": "node scripts/build-vercel.js",
    "setup:supabase": "node scripts/setup-supabase.js",
    "ref": "node scripts/export-reference.js",
    "seed:oracle": "node apps/api/seed_oracle.js --db=apps/api/_oracle.db --force",
    "actual": "node scripts/export-actual.js --db=apps/api/_oracle.db",
    "compare": "node scripts/compare.js",
    "scenarios": "node scripts/scenarios.js",
    "invariants": "node scripts/invariants.js",
    "audit:wallet": "node scripts/wallet-audit.js",
    "permissions": "node scripts/permissions.js",
    "visual": "node scripts/visual.js",
    "verify:seed": "npm run seed:oracle && npm run actual && npm run compare",
    "verify:server": "npm --prefix apps/api test",
    "verify": "npm run verify:server && npm run verify:seed && npm run scenarios && npm run invariants && npm run permissions && npm run audit:wallet",
    "db:model": "node scripts/gen-db-model.js",
    "db:migrate": "node scripts/migrate-sqlite-to-pg.js",
    "db:migrate:apply": "node scripts/migrate-sqlite-to-pg.js --apply",
    "db:parity": "node scripts/verify-parity.js",
    "api:contract": "node scripts/gen-api-contract.js",
    "api:contract:check": "node scripts/gen-api-contract.js --check",
    "web:config": "node scripts/gen-web-config.js"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.1",
    "pg": "^8.13.1"
  }
}
