# =========================================================
# D-aôna — Variables d'environnement (EXEMPLE, sans aucun secret)
# =========================================================
# IMPORTANT — ce fichier est un MODÈLE de documentation, pas un fichier
# chargé automatiquement : l'application n'utilise PAS dotenv, donc un
# fichier `.env` n'est jamais lu. Ces variables doivent être définies dans
# l'environnement réel du processus.
#
#   Windows (PowerShell) :  $env:D_AONA_PORT = "8080"; node server.js
#   Windows (cmd/.bat)   :  set D_AONA_PORT=8080 && node server.js
#
# Aucune de ces variables n'est OBLIGATOIRE : les valeurs par défaut
# conviennent au fonctionnement normal (PC hôte, port 8080).

# ---- Réseau ----
# Port d'écoute. D_AONA_PORT est prioritaire, sinon PORT.
# D_AONA_PORT=8080

# À activer UNIQUEMENT si le serveur est derrière un proxy/tunnel de
# confiance (Cloudflare). Permet de lire l'IP réelle dans
# CF-Connecting-IP / X-Forwarded-For. Laisser désactivé en réseau local :
# sinon un client peut annoncer une fausse IP et contourner la limitation
# de débit.
# D_AONA_TRUST_PROXY=0

# ---- Authentification ----
# Nombre de tentatives d'authentification autorisées par IP et par fenêtre.
# Valeur par défaut : 12.
# ⚠ Derrière un hotspot partagé (tous les joueurs sortent par la même IP),
# cette valeur peut gêner un tournoi : l'augmenter si nécessaire.
# D_AONA_AUTH_RATE_MAX=12

# Durée de la fenêtre de limitation, en secondes. Défaut : 300.
# D_AONA_AUTH_RATE_WINDOW_S=300

# Autorise la définition du mot de passe des comptes créés AVANT la refonte
# de sécurité (route /api/auth/claim). Valeur par défaut : activé.
# ⚠ À PASSER À 0 avant toute mise en service avec de l'argent réel :
# tant que cette fenêtre est ouverte, le premier arrivé peut réclamer un
# compte hérité. Voir SECURITE_AUTH.md.
# D_AONA_ALLOW_LEGACY_CLAIM=0

# ---- Secrets (aucun pour l'instant) ----
# Il n'y a AUCUNE clé d'API ni mot de passe de base ici : SQLite est un
# fichier local et les paiements mobile money ne sont pas encore branchés.
# Le jour où un prestataire (MVola / Orange Money / Airtel Money) et un
# stockage objet pour le KYC seront intégrés, leurs secrets se placeront
# dans l'environnement ou un coffre — JAMAIS dans un fichier versionné.
