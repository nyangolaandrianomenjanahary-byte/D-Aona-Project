{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "public",
  "functions": {
    "api/index.js": {
      "maxDuration": 30,
      "includeFiles": "{supabase/schema.sql,apps/web/**,apps/api/games/**,apps/api/data.js,apps/api/image.js,apps/api/admin/permissions.js}"
    }
  },
  "rewrites": [
    {
      "source": "/api",
      "destination": "/api/index?__path=/api"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index?__path=/api/$1"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "/api/index?__path=/uploads/$1"
    }
  ]
}
