# =========================================================
# D-aôna — Variables d'environnement du backend (MODÈLE)
# =========================================================
# IMPORTANT — ce fichier est un MODÈLE de documentation, pas un fichier
# chargé automatiquement : l'application n'utilise PAS dotenv, donc un
# fichier `.env` n'est jamais lu. Ces variables doivent être définies dans
# l'environnement réel du processus (tableau de bord Render/Railway).
#
#   Windows (PowerShell) :  $env:D_AONA_PORT = "8080"; node server.js
#   Windows (cmd/.bat)    :  set D_AONA_PORT=8080 && node server.js
#   Hébergeur             :  tableau de bord → Environment
#
# Aucune de ces variables n'est OBLIGATOIRE en mode hôte : les valeurs par
# défaut reproduisent le comportement historique (PC hôte, port 8080).

# ---- Réseau ----
# Port d'écoute. D_AONA_PORT est prioritaire, sinon PORT, sinon 8080.
# D_AONA_PORT=8080

# À activer UNIQUEMENT si le serveur est derrière un proxy/tunnel de
# confiance (Cloudflare, Render, Railway). Permet de lire l'IP réelle dans
# CF-Connecting-IP / X-Forwarded-For.
#
# SUR UN HÉBERGEUR, CE RÉGLAGE EST OBLIGATOIRE : sans lui, tous les joueurs
# partagent l'IP du proxy et la limitation de débit d'authentification
# (12 tentatives / 300 s) bloque la salle entière.
# En réseau local, laisser désactivé : sinon un client peut annoncer une
# fausse IP et contourner la limitation.
# D_AONA_TRUST_PROXY=0

# ---- Déploiement séparé (frontend Vercel → API Render/Railway) ----
# Origines autorisées à ouvrir une WebSocket depuis un navigateur, séparées
# par des virgules, SANS barre oblique finale.
# En mode hôte (même origine), laisser vide.
# D_AONA_ALLOWED_ORIGINS=https://d-aona.vercel.app,https://d-aona-git-main.vercel.app
#
# Adresse publique de cette API (sert à construire la CSP et les liens).
# D_AONA_PUBLIC_API_URL=https://d-aona-api.onrender.com

# ---- Base de données ----
# Moteur utilisé. Absent = sqlite (comportement historique).
# « postgres » n'est opérationnel qu'à partir du lot L5 (docs/NEXT-STEPS.md).
# D_AONA_DB=sqlite
#
# Chemin du fichier SQLite (tests et sauvegardes : base jetable).
# D_AONA_DB_PATH=./d-aona.db
#
# Chaîne Postgres Supabase. Deux adresses différentes, à ne pas confondre :
#   · port 6543 = pooler (Supavisor) → pour le serveur, `prepare: false` ;
#   · port 5432 = connexion directe  → pour les migrations et l'import.
# DATABASE_URL=postgresql://postgres.<ref>:<motdepasse>@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
# PGSSL=disable   # uniquement pour un Postgres local sans TLS

# ---- Supabase (Auth + Storage) ----
# Clé de service : SECRÈTE. Ne jamais l'exposer au frontend.
# SUPABASE_URL=https://<ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# Vérification des JWT (lot L7) : JWKS public, aucun secret à stocker.
# SUPABASE_JWKS_URL=https://<ref>.supabase.co/auth/v1/.well-known/jwks.json

# ---- Authentification (mode hôte, avant Supabase Auth) ----
# Nombre de tentatives d'authentification autorisées par IP et par fenêtre.
# Valeur par défaut : 12.
# D_AONA_AUTH_RATE_MAX=12
# Durée de la fenêtre de limitation, en secondes. Défaut : 300.
# D_AONA_AUTH_RATE_WINDOW_S=300

# ---- Temps réel ----
# Délai de grâce avant abandon sur déconnexion, en millisecondes.
# Surchargé uniquement par les sondes de test. Défaut : 20000.
# D_AONA_GRACE_MS=20000

# ---- Seed (base de démonstration) ----
# Le seed réécrivait 98 comptes de référence + 5 tournois À CHAQUE démarrage.
# DÉSACTIVÉ par défaut : la base reste exactement dans l'état où elle est.
# D_AONA_SEED=1

# ---- Secrets ----
# Aucune clé d'API ni mot de passe de base dans ce dépôt. Les secrets vivent
# dans l'environnement de l'hébergeur ou dans un coffre — JAMAIS dans un
# fichier versionné.
